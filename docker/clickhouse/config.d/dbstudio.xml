<!-- Extra ClickHouse settings for the test containers (mounted into /etc/clickhouse-server/config.d):
     a small memory footprint, a `backups` disk for BACKUP/RESTORE, and an HTTPS port (8443) with
     the test CA certificate generated by docker/gen-certs.sh. Package H may adjust this file. -->
<clickhouse>
    <max_server_memory_usage>700000000</max_server_memory_usage>
    <mark_cache_size>67108864</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <https_port>8443</https_port>
    <openSSL>
        <server>
            <certificateFile>/certs/clickhouse.crt</certificateFile>
            <privateKeyFile>/certs/clickhouse.key</privateKeyFile>
            <verificationMode>none</verificationMode>
            <loadDefaultCAFile>true</loadDefaultCAFile>
            <cacheSessions>true</cacheSessions>
            <disableProtocols>sslv2,sslv3</disableProtocols>
            <preferServerCiphers>true</preferServerCiphers>
        </server>
    </openSSL>
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/var/lib/clickhouse/backups/</path>
            </backups>
        </disks>
    </storage_configuration>
    <backups>
        <allowed_disk>backups</allowed_disk>
        <allowed_path>/var/lib/clickhouse/backups/</allowed_path>
    </backups>
</clickhouse>
