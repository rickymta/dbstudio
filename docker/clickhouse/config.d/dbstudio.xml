<!-- Extra ClickHouse settings for the test containers (mounted into /etc/clickhouse-server/config.d):
     a small memory footprint, a `backups` disk for BACKUP/RESTORE, and an HTTPS port (8443) with
     the test CA certificate generated by docker/gen-certs.sh. Package H may adjust this file. -->
<clickhouse>
    <!-- Mounting this directory hides the image's docker_related_config.xml, so listen on all
         interfaces here (otherwise published ports answer with an empty reply). -->
    <listen_host>0.0.0.0</listen_host>
    <listen_try>1</listen_try>
    <max_server_memory_usage>800000000</max_server_memory_usage>
    <mark_cache_size>33554432</mark_cache_size>
    <index_mark_cache_size>16777216</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <mmap_cache_size>0</mmap_cache_size>
    <compiled_expression_cache_size>0</compiled_expression_cache_size>
    <background_schedule_pool_size>4</background_schedule_pool_size>
    <background_move_pool_size>1</background_move_pool_size>
    <background_fetches_pool_size>1</background_fetches_pool_size>
    <background_common_pool_size>4</background_common_pool_size>
    <!-- The system log tables grow in memory and on disk for nothing in a throw-away test server. -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <session_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <profiles>
        <default>
            <max_threads>2</max_threads>
        </default>
    </profiles>
    <https_port>8443</https_port>
    <openSSL>
        <server>
            <certificateFile>/certs/clickhouse.crt</certificateFile>
            <privateKeyFile>/certs/clickhouse.key</privateKeyFile>
            <verificationMode>none</verificationMode>
            <loadDefaultCAFile>true</loadDefaultCAFile>
            <cacheSessions>true</cacheSessions>
            <disableProtocols>sslv2,sslv3</disableProtocols>
            <preferServerCiphers>true</preferServerCiphers>
        </server>
    </openSSL>
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/var/lib/clickhouse/backups/</path>
            </backups>
        </disks>
    </storage_configuration>
    <backups>
        <allowed_disk>backups</allowed_disk>
        <allowed_path>/var/lib/clickhouse/backups/</allowed_path>
    </backups>
</clickhouse>
